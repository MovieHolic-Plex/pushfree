<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network access for the WS transport + ack outbox. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- API 33+: runtime permission to post notifications. Notifications are
         still built regardless of grant state; this only governs display. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- API 34+: full-screen intent for emergency-priority messages. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Foreground service hosting the persistent WS connection (doze survival). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Request the battery-optimization exemption prompt for the WS transport. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pushfree"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Pushfree">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".notifications.NotificationActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="net.pushfree.android.action.ACK" />
            </intent-filter>
        </receiver>

        <!-- Persistent foreground service that holds the WebSocket connection
             open across doze so the server keepalive/replay path stays live.
             dataSync is the Android 14+ type for a long-running sync/messaging
             connection (ntfy pattern). -->
        <service
            android:name=".ws.WsForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Optional FCM transport (todo 30). Receives data-only messages and
             routes them to the Room store + notification pipeline. Only active
             when google-services.json was present at build time (FirebaseApp
             initialized); absent that, the service is never started -> the
             channel is runtime-disabled and the build still succeeds. -->
        <service
            android:name=".fcm.PushfreeFcmService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- UnifiedPush connector receiver (todo 31). A distributor app on the
             device delivers pushes by broadcasting these actions; exported so
             the distributor (a separate app) can reach it. When no distributor
             is installed the transport stays disabled and WS remains primary
             (UnifiedPushDistributor.isAvailable gate). -->
        <receiver
            android:name=".up.PushfreeUpReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.NEW_ENDPOINT" />
                <action android:name="org.unifiedpush.android.connector.MESSAGE_RECEIVED" />
                <action android:name="org.unifiedpush.android.connector.UNREGISTERED" />
                <action android:name="org.unifiedpush.android.connector.REGISTERED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
